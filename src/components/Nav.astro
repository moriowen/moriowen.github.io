---
// Top bar for every page except the overview, which is short enough not to
// need one. Name links home; sections link to their index pages.
import { sections } from '../data/sections';
import { site } from '../data/site';

const path = Astro.url.pathname;
const home = path === '/';
---

{
  !home && (
    <nav class="sitenav" aria-label="Site">
      <a class="sitenav-name" href="/">{site.name}</a>
      <span class="sitenav-links">
        {sections.map((s) => (
          <a href={`/${s.slug}/`} aria-current={path.startsWith(`/${s.slug}`) ? 'page' : undefined}>
            {s.title}
          </a>
        ))}
      </span>
    </nav>
  )
}
