---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const { sections } = await import('../../data/sections');
  const paths = await Promise.all(
    sections.map(async (s) => {
      const entries = await getCollection(s.slug, ({ data }) => !data.draft);
      return entries.map((entry) => ({
        params: { section: s.slug, slug: entry.id },
        props: { entry, section: s },
      }));
    })
  );
  return paths.flat();
}

const { entry, section } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const contents = d.contents.map((item) => {
  const heading = headings.find((h) => h.depth === 2 && h.text === item.heading);
  if (!heading) throw new Error(`Missing contents heading in ${entry.id}: ${item.heading}`);
  return { ...item, href: `#${heading.slug}` };
});
---

<Base title={`${d.title} - ${site.name}`} description={d.summary ?? section.blurb}>
  <h1 class="name">{d.title}</h1>
  {d.subtitle && <p class="entry-sub">{d.subtitle}</p>}
  {d.meta && <p class="tagline">{d.meta}</p>}

  {
    d.external.length > 0 && (
      <nav class="links">
        {d.external.map((l) => (
          <a href={l.href} rel="noopener">
            {l.label}
          </a>
        ))}
      </nav>
    )
  }

  {
    d.roles.length > 0 && (
      <div class="roles roles-top">
        {d.roles.map((r) => (
          <div class="role">
            <div class="role-head">
              <h2 class="role-title">{r.title}</h2>
              {r.when && <span class="role-when">{r.when}</span>}
            </div>
            {(r.where || r.kind) && (
              <p class="role-where">{[r.kind, r.where].filter(Boolean).join(' \u00b7 ')}</p>
            )}
            {contents.length === 0 && r.bullets.length > 0 && (
              <ul class="bullets">
                {r.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    )
  }

  {
    contents.length > 0 && (
      <nav class="page-contents" aria-labelledby="page-contents-title">
        <h2 id="page-contents-title">On this page</h2>
        <ol>
          {contents.map((item) => (
            <li>
              <a href={item.href}>
                <span class="contents-title">{item.heading}</span>
                <span class="contents-description">{item.description}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <article class="prose">
    <Content />
  </article>

  <footer>
    <p>
      <a href={`/${section.slug}/`}>&larr; All {section.title.toLowerCase()}</a>
    </p>
  </footer>
</Base>
