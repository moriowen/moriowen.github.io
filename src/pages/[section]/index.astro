---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const { sections } = await import('../../data/sections');
  return Promise.all(
    sections.map(async (s) => ({
      params: { section: s.slug },
      props: {
        section: s,
        entries: (await getCollection(s.slug, ({ data }) => !data.draft))
          .sort((a, b) => a.data.order - b.data.order)
          .map((e) => ({ ...e, href: `/${s.slug}/${e.id}/` })),
      },
    }))
  );
}

const { section, entries } = Astro.props;
---

<Base title={`${section.title} - ${site.name}`} description={section.blurb}>
  <h1 class="name">{section.title}</h1>
  <p class="blurb">{section.blurb}</p>

  <section class="bare">
    <EntryList slug={section.slug} entries={entries} />
  </section>
</Base>
