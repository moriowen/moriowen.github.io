---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(entry);
---

<Base title={`About - ${site.name}`} description={entry.data.description ?? site.description}>
  <nav class="crumb"><a href="/">&larr; {site.name}</a></nav>

  <h1 class="name">{entry.data.title}</h1>

  <article class="prose">
    <Content />
  </article>

  <footer>
    <p><a href="/">Back to the overview</a></p>
  </footer>
</Base>
