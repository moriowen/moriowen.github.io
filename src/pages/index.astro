---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import { site, links, intro, skills, elsewhere } from '../data/site';
import { sections } from '../data/sections';

const live = await Promise.all(
  sections.map(async (s) => ({
    ...s,
    entries: (await getCollection(s.slug, ({ data }) => !data.draft)).sort(
      (a, b) => a.data.order - b.data.order
    ),
  }))
);

const year = new Date().getFullYear();
---

<Base>
  <header>
    <h1 class="name">{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <nav class="links">
      {links.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
    </nav>
  </header>

  <Section title="About" href="/about/">
    {intro.map((p) => <p>{p}</p>)}
  </Section>

  {
    live.map((s) => (
      <Section title={s.title} href={`/${s.slug}/`}>
        {s.entries.map((e) => (
          <Entry
            href={`/${s.slug}/${e.id}/`}
            title={e.data.title}
            subtitle={e.data.subtitle}
            meta={e.data.meta}
            summary={e.data.summary}
            bullets={e.data.bullets}
          />
        ))}
      </Section>
    ))
  }

  <Section title="Skills">
    <div class="skills">
      {
        skills.map((s) => (
          <div>
            <strong>{s.group}</strong> <span>{s.items}</span>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Elsewhere">
    <p class="note">{elsewhere}</p>
  </Section>

  <footer>
    <p>&copy; {year} {site.name} &middot; {site.location}</p>
  </footer>
</Base>
