---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import { site, links, tagline } from '../data/site';
import { sections } from '../data/sections';

const live = await Promise.all(
  sections.map(async (s) => ({
    ...s,
    entries: (await getCollection(s.slug, ({ data }) => !data.draft)).sort(
      (a, b) => a.data.order - b.data.order
    ),
  }))
);

const year = new Date().getFullYear();
---

<Base>
  <header>
    <img
      class="avatar"
      src="/img/atharva.jpg"
      alt={site.name}
      width="400"
      height="400"
      loading="eager"
      decoding="async"
    />
    <h1 class="name">{site.name}</h1>
    {tagline.map((t, i) => <p class={i === 0 ? 'tagline' : 'tagline clear'}>{t}</p>)}
    <nav class="links">
      {links.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
    </nav>
  </header>


  {
    live.map((s) => (
      <Section title={s.title} href={`/${s.slug}/`} id={s.slug}>
        {s.entries.map((e) => (
          <Entry
            href={`/${s.slug}/${e.id}/`}
            title={e.data.title}
            subtitle={e.data.subtitle}
            meta={e.data.meta}
            summary={e.data.summary}
            bullets={e.data.bullets}
            roles={e.data.roles}
          />
        ))}
      </Section>
    ))
  }


  <footer>
    <p>&copy; {year} {site.name} &middot; {site.location}</p>
  </footer>
</Base>
