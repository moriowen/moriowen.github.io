---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import {
  site,
  links,
  about,
  education,
  experience,
  publications,
  projects,
  awards,
  skills,
  elsewhere,
} from '../data/site';

const year = new Date().getFullYear();
---

<Base>
  <header>
    <h1 class="name">{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <nav class="links">
      {links.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
    </nav>
  </header>

  <Section title="About">
    {about.map((p) => <p>{p}</p>)}
  </Section>

  <Section title="Experience">
    {
      experience.map((e) => (
        <div class="entry">
          <div class="entry-head">
            <h3 class="entry-title">{e.role}</h3>
            <span class="entry-when">{e.when}</span>
          </div>
          <p class="entry-sub">{e.org}</p>
          <ul class="bullets">
            {e.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      ))
    }
  </Section>

  <Section title="Publications">
    {
      publications.map((p) => (
        <div class="entry">
          <div class="entry-head">
            <h3 class="entry-title">
              {p.href ? <a href={p.href}>{p.title}</a> : p.title}
            </h3>
            <span class="entry-when">{p.venue}</span>
          </div>
          <p class="entry-sub">{p.authors}</p>
          <p class="note">{p.note}</p>
        </div>
      ))
    }
  </Section>

  <Section title="Projects">
    {
      projects.map((p) => (
        <div class="entry">
          <div class="entry-head">
            <h3 class="entry-title">
              {p.href ? <a href={p.href}>{p.name}</a> : p.name}
            </h3>
            <span class="entry-when">{p.stack}</span>
          </div>
          <p class="note">{p.note}</p>
        </div>
      ))
    }
  </Section>

  <Section title="Education">
    {
      education.map((e) => (
        <div class="entry">
          <div class="entry-head">
            <h3 class="entry-title">{e.school}</h3>
            <span class="entry-when">{e.when}</span>
          </div>
          <p class="entry-sub">
            {e.degree} &middot; {e.where}
          </p>
        </div>
      ))
    }
  </Section>

  <Section title="Skills">
    <div class="skills">
      {
        skills.map((s) => (
          <div>
            <strong>{s.group}</strong> <span>{s.items}</span>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Awards">
    <ul class="bullets">
      {awards.map((a) => <li>{a}</li>)}
    </ul>
  </Section>

  <Section title="Elsewhere">
    <p class="note">{elsewhere}</p>
  </Section>

  <footer>
    <p>&copy; {year} {site.name} &middot; {site.location}</p>
  </footer>
</Base>
